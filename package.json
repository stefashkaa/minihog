{
  "name": "minihog-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --stream run build",
    "clean": "pnpm -r --filter \"./packages/**\" --stream run clean",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm -r --filter \"./packages/**\" run typecheck && pnpm --filter demo typecheck",
    "check:peers": "pnpm peers check",
    "audit:prod": "pnpm audit --prod",
    "size": "node scripts/check-size.mts",
    "test:unit": "pnpm -r --filter \"./packages/**\" run test:unit",
    "test:unit:coverage": "pnpm -r --filter \"./packages/**\" run test:unit:coverage",
    "test:e2e": "pnpm --filter @minihog/nuxt test:e2e",
    "publish:check": "pnpm -r --filter \"./packages/**\" --stream run publish:check",
    "check:release": "pnpm format:check && pnpm lint && pnpm check:peers && pnpm audit:prod && pnpm build && pnpm typecheck && pnpm build:demo && pnpm publish:check && pnpm size && pnpm check:install && pnpm test:unit:coverage && pnpm test:e2e",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm --filter minihog build:version && node scripts/format-changelog-dependencies.mts",
    "changeset:publish": "pnpm build && pnpm publish:check && changeset publish --no-git-tag",
    "prepare": "husky",
    "dev:demo": "pnpm build && pnpm --filter demo dev",
    "build:demo": "pnpm --filter demo build",
    "vercel-build": "pnpm build && pnpm build:demo",
    "benchmark": "pnpm build && node scripts/compare-posthog.mts",
    "check:install": "node scripts/check-install.mts",
    "comparison:update": "pnpm build && node scripts/compare-posthog.mts --update-docs && prettier --write COMPARISON.md"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "posthog-js": "1.450.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
