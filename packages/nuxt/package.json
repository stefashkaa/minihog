{
  "name": "@minihog/nuxt",
  "version": "0.1.0",
  "description": "Nuxt module for MiniHog with a same-origin PostHog proxy and deferred startup.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "clean": "rimraf dist coverage",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage.enabled",
    "publish:check": "node ../../scripts/check-package.mts --profile esm-only"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@minihog/core": "workspace:^",
    "@nuxt/kit": "^4.6.4",
    "@nuxt/schema": "^4.6.4",
    "h3": "^1.15.11"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "nuxt": "^4.6.4",
    "vue": "^3.5.45"
  },
  "author": "Stefan Popov <hello@stefanpopov.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefashkaa/minihog.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/stefashkaa/minihog/issues"
  },
  "homepage": "https://github.com/stefashkaa/minihog/tree/main/packages/nuxt#readme",
  "private": false,
  "keywords": [
    "posthog",
    "analytics",
    "typescript",
    "tree-shaking",
    "minihog",
    "nuxt",
    "nuxt-module",
    "proxy"
  ],
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts"
}
